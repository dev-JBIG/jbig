  "jest": {
    "moduleNameMapper": {
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js",
      "^@oddbird/popover-polyfill/fn$": "<rootDir>/node_modules/@oddbird/popover-polyfill/dist/popover-fn.cjs.js",
      "^@github/relative-time-element$": "<rootDir>/src/__mocks__/relativeTimeMock.js",
      "^@primer/primitives/dist/css/(.+)\\.css$": "<rootDir>/src/__mocks__/styleMock.js",
      "^@primer/react/dist/(.+)\\.css$": "<rootDir>/src/__mocks__/styleMock.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](?!(@primer|@github|@lit|@lit-labs|lit|lit-html|lit-element|@oddbird|@tanstack|clsx|color2k|hsluv|react-intersection-observer|deepmerge|focus-visible)[/\\\\]).+\\.(js|jsx|mjs|cjs|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
